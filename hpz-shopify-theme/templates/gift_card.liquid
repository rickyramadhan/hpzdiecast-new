{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ 'hpz.account.gift_title' | t }} | {{ shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  <style>
    .gc-page{min-height:100vh;display:grid;place-items:center;padding:24px;background:var(--paper,#f2f2ef)}
    .gc-card{max-width:520px;width:100%;background:#fff;border:1px solid rgba(0,0,0,.12);padding:32px;display:grid;gap:16px;text-align:center}
    .gc-code{font-size:1.6rem;letter-spacing:.12em;padding:14px;border:2px dashed rgba(0,0,0,.25);user-select:all}
    .gc-bal{font-size:2.4rem;font-weight:800}
    @media print{.gc-actions{display:none}}
  </style>
</head>
<body>
  <main class="gc-page">
    <div class="gc-card">
      <span class="eyebrow"><b>{{ shop.name }}</b></span>
      <h1 class="h2">{{ 'hpz.account.gift_title' | t }}</h1>
      <div class="gc-bal mono">{{ gift_card.initial_value | money }}</div>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="small muted">{% if gift_card.expired %}{{ 'hpz.account.gift_expired' | t }}{% else %}{{ 'hpz.account.gift_disabled' | t }}{% endif %}</p>
      {%- elsif gift_card.balance != gift_card.initial_value -%}
        <p class="small">{{ 'hpz.account.gift_remaining' | t }}: <b class="mono">{{ gift_card.balance | money }}</b></p>
      {%- endif -%}
      <div class="gc-code mono">{{ gift_card.code | format_code }}</div>
      {%- if gift_card.expires_on -%}<p class="xs muted">{{ 'hpz.account.gift_expires' | t }} {{ gift_card.expires_on | date: '%d %b %Y' }}</p>{%- endif -%}
      <div class="gc-actions" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-signal" href="{{ shop.url }}">{{ 'hpz.account.gift_use' | t }}</a>
        <button class="btn btn-ghost" type="button" onclick="window.print()">{{ 'hpz.account.gift_print' | t }}</button>
        {%- if gift_card.pass_url -%}<a class="btn btn-ghost" href="{{ gift_card.pass_url }}">{{ 'hpz.account.gift_wallet' | t }}</a>{%- endif -%}
      </div>
    </div>
  </main>
</body>
</html>
