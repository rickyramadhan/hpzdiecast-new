{{ 'p-product.css' | asset_url | stylesheet_tag }}
{%- assign recs_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: section.settings.intent -%}

{%- assign fb_coll = null -%}
{%- assign fb_count = 0 -%}
{%- unless recommendations.performed and recommendations.products_count > 0 -%}
  {%- for c in product.collections -%}
    {%- if c.handle != 'all' and c.handle != 'frontpage' and c.products_count > 1 and fb_coll == null -%}{%- assign fb_coll = c -%}{%- endif -%}
  {%- endfor -%}
{%- endunless -%}

<section class="section-s" id="recs-s" data-recs data-url="{{ recs_url }}"{% if fb_coll != null %} data-fallback{% elsif recommendations.performed == false %} hidden{% endif %}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    {%- assign rec_products = recommendations.products -%}
  {%- elsif fb_coll != null -%}
    {%- assign rec_products = fb_coll.products -%}
  {%- endif -%}
  {%- if rec_products != blank -%}
    <div class="wrap">
      <div class="shead">
        <span class="idx">&rarr;</span>
        <div><h2 class="h2">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'hpz.product.recs_heading' | t }}{% endif %}</h2></div>
        <div class="rail-nav">
          <button type="button" data-rc-prev aria-label="{{ 'hpz.product.prev' | t }}">{% render 'icon', name: 'left' %}</button>
          <button type="button" data-rc-next aria-label="{{ 'hpz.product.next' | t }}">{% render 'icon', name: 'right' %}</button>
        </div>
      </div>
      <div class="rail" data-rc-rail>
        {%- for p in rec_products limit: 14 -%}
          {%- if p.id != product.id and fb_count < 12 -%}
            {%- assign fb_count = fb_count | plus: 1 -%}
            {% render 'product-card', product: p, index: forloop.index0, lazy: true %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Blank uses the translated default." },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [
      { "value": "related", "label": "Related" },
      { "value": "complementary", "label": "Complementary" }
    ] },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 4, "max": 10, "step": 1, "default": 10 }
  ]
}
{% endschema %}
