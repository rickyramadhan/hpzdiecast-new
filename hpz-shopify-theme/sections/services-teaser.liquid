{{ 'p-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'hpz.home.svc.heading' | t
  endif
  assign sub = s.subheading
  if sub == blank
    assign sub = 'hpz.home.svc.sub' | t
  endif
-%}
{%- if section.blocks.size > 0 -%}
<section class="section svc-s" data-home="svc" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="shead">
      {%- if s.idx != blank -%}<span class="idx">{{ s.idx }}</span>{%- endif -%}
      <div><h2 class="h2">{{ heading }}</h2>{%- if sub != blank -%}<p>{{ sub }}</p>{%- endif -%}</div>
    </div>
    <div class="svc">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign tag = 'div' -%}
        {%- if b.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
        <{{ tag }} class="sv sv-{{ b.icon }}{% if b.dark %} sv-build{% endif %}"{% if b.link != blank %} href="{{ b.link }}"{% endif %} data-reveal style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="sv-top"><span class="sv-ic">{% render 'icon', name: b.icon %}</span><span class="mono sv-n">S-0{{ forloop.index }}</span></div>
          <h3 class="h3">{{ b.title }}</h3>
          <p>{{ b.text }}</p>
          {%- if b.fact1_value != blank or b.fact2_value != blank or b.fact3_value != blank -%}
            <dl>
              {%- if b.fact1_value != blank -%}<div><dt>{{ b.fact1_label }}</dt><dd class="mono">{{ b.fact1_value }}</dd></div>{%- endif -%}
              {%- if b.fact2_value != blank -%}<div><dt>{{ b.fact2_label }}</dt><dd class="mono">{{ b.fact2_value }}</dd></div>{%- endif -%}
              {%- if b.fact3_value != blank -%}<div><dt>{{ b.fact3_label }}</dt><dd class="mono">{{ b.fact3_value }}</dd></div>{%- endif -%}
            </dl>
          {%- endif -%}
          {%- if b.link != blank -%}
            <span class="arrow-link">{% if b.link_label != blank %}{{ b.link_label }}{% else %}{{ 'hpz.home.svc.start' | t }}{% endif %} {% render 'icon', name: 'arrow' %}</span>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Services teaser",
  "settings": [
    { "type": "text", "id": "idx", "label": "Index number", "default": "07" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Blank = translated default." },
    { "type": "text", "id": "subheading", "label": "Subheading", "info": "Blank = translated default." }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 3,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "layers",
          "options": [
            { "value": "layers", "label": "Layers" },
            { "value": "wheel", "label": "Wheel" },
            { "value": "box", "label": "Box" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        { "type": "checkbox", "id": "dark", "label": "Dark card", "default": false },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "header", "content": "Facts (leave the value blank to hide)" },
        { "type": "text", "id": "fact1_label", "label": "Fact 1 label" },
        { "type": "text", "id": "fact1_value", "label": "Fact 1 value" },
        { "type": "text", "id": "fact2_label", "label": "Fact 2 label" },
        { "type": "text", "id": "fact2_value", "label": "Fact 2 value" },
        { "type": "text", "id": "fact3_label", "label": "Fact 3 label" },
        { "type": "text", "id": "fact3_value", "label": "Fact 3 value" },
        { "type": "header", "content": "Link" },
        { "type": "url", "id": "link", "label": "Link", "info": "e.g. /pages/services#decal" },
        { "type": "text", "id": "link_label", "label": "Link label", "info": "Blank = translated default." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services teaser",
      "blocks": [
        { "type": "service", "settings": { "icon": "layers", "title": "Custom decals", "text": "Send us a reference and we draw a decal sheet to fit your casting." } },
        { "type": "service", "settings": { "icon": "wheel", "dark": true, "title": "Commission build", "text": "We build the car for you: wheel swap, stance, paint and decals." } },
        { "type": "service", "settings": { "icon": "box", "title": "Wholesale and stockists", "text": "Pricing for hobby shops and resellers. Get in touch for details." } }
      ]
    }
  ]
}
{% endschema %}
