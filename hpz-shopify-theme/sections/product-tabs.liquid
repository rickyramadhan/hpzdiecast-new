{{ 'p-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'hpz.home.tabs.heading' | t
  endif
  assign first_coll = section.blocks.first.settings.collection
  assign first_sort = ''
  if section.blocks.size > 0
    assign first_sort = section.blocks.first.settings.sort
  endif
-%}
<section class="section" data-home="tabs" data-tabs-fade="true" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="shead">
      {%- if s.idx != blank -%}<span class="idx">{{ s.idx }}</span>{%- endif -%}
      <div><h2 class="h2">{{ heading }}</h2></div>
      {%- if section.blocks.size > 1 -%}
        <div class="tabs" data-tabs>
          {%- for block in section.blocks -%}
            <button type="button" data-tab="{{ block.id }}" data-coll="{{ block.settings.collection.handle }}" data-sort="{{ block.settings.sort }}" data-limit="{{ s.limit }}" class="{% if forloop.first %}is-on{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="grid p-grid" data-tabs-target style="--cols:{{ s.columns }}">
      {%- if first_coll != blank -%}
        {% render 'home-tab-cards', collection: first_coll, sort: first_sort, limit: s.limit %}
      {%- elsif request.design_mode -%}
        <p class="muted">Add tabs and choose a collection for each.</p>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}
        <template data-tab-tpl="{{ block.id }}" data-href="{{ block.settings.collection.url }}" data-count="{{ block.settings.collection.products_count }}">
          {% render 'home-tab-cards', collection: block.settings.collection, sort: block.settings.sort, limit: s.limit %}
        </template>
      {%- endunless -%}
    {%- endfor -%}
    {%- if first_coll != blank -%}
      <div class="more">
        <a class="btn btn-ghost" data-tabs-more href="{{ first_coll.url }}" data-count="{{ first_coll.products_count }}">{{ 'hpz.home.tabs.view_all' | t }} <span class="mono">{{ first_coll.products_count }}</span> {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product tabs",
  "settings": [
    { "type": "text", "id": "idx", "label": "Index number", "default": "05" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Blank = translated default." },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Blank = collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "sort", "label": "Sort", "default": "", "options": [ { "value": "", "label": "Collection default" }, { "value": "created-descending", "label": "Newest first" }, { "value": "best-selling", "label": "Best selling" }, { "value": "price-ascending", "label": "Price, low to high" } ] }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Product tabs", "blocks": [ { "type": "tab" }, { "type": "tab" }, { "type": "tab" }, { "type": "tab" } ] }
  ]
}
{% endschema %}
