{{ 'p-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'HPZ Originals'
  endif
  assign tab_count = section.blocks.size
  assign first_coll = s.collection
  assign first_sort = ''
  if section.blocks.size > 0
    assign first_sort = section.blocks.first.settings.sort
  endif
  if tab_count > 0
    assign first_coll = section.blocks.first.settings.collection
  endif
-%}
<section class="section on-white" data-home="tabs" data-tabs-fade="false" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="shead">
      {%- if s.idx != blank -%}<span class="idx">{{ s.idx }}</span>{%- endif -%}
      <div><h2 class="h2">{{ heading }}</h2>{%- if s.subheading != blank -%}<p>{{ s.subheading }}</p>{%- endif -%}</div>
      <div class="rail-nav">
        <button type="button" data-rail-prev aria-label="{{ 'hpz.home.common.prev' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg></button>
        <button type="button" data-rail-next aria-label="{{ 'hpz.home.common.next' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
      </div>
    </div>
    {%- if tab_count > 1 -%}
      <div class="tabs o-tabs" data-tabs>
        {%- for block in section.blocks -%}
          <button type="button" data-tab="{{ block.id }}" data-coll="{{ block.settings.collection.handle }}" data-sort="{{ block.settings.sort }}" data-limit="{{ s.limit }}" class="{% if forloop.first %}is-on{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <div class="rail" data-tabs-target>
      {%- if first_coll != blank -%}
        {% render 'home-tab-cards', collection: first_coll, sort: first_sort, limit: s.limit %}
      {%- elsif request.design_mode -%}
        <p class="muted">Choose a collection (or add tabs with a collection each).</p>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- unless forloop.first -%}
        <template data-tab-tpl="{{ block.id }}" data-href="{{ block.settings.collection.url }}">
          {% render 'home-tab-cards', collection: block.settings.collection, sort: block.settings.sort, limit: s.limit %}
        </template>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>
<script src="{{ 'home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection rail",
  "settings": [
    { "type": "text", "id": "idx", "label": "Index number", "default": "03" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HPZ Originals" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection (used when there are no tabs)" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 16, "step": 1, "default": 10 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Blank = collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "sort", "label": "Sort", "default": "", "options": [ { "value": "", "label": "Collection default" }, { "value": "created-descending", "label": "Newest first" }, { "value": "best-selling", "label": "Best selling" }, { "value": "price-ascending", "label": "Price, low to high" } ] }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Collection rail", "blocks": [ { "type": "tab" }, { "type": "tab" } ] }
  ]
}
{% endschema %}
