{{ 'p-shop.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign terms = search.terms
  assign per_page = section.settings.per_page
  assign types_str = search.types | join: ','
  assign active_tab = 'all'
  if search.types.size == 1
    assign active_tab = search.types.first
  endif
  assign has_filters = false
  if search.filters.size > 0
    assign has_filters = true
  endif
  assign has_active = false
  for f in search.filters
    if f.active_values.size > 0
      assign has_active = true
    endif
    if f.type == 'price_range'
      if f.min_value.value or f.max_value.value
        assign has_active = true
      endif
    endif
  endfor
  assign enc_terms = terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: enc_terms | append: '&type=' | append: types_str
-%}

<section class="col-head">
  <div class="wrap">
    <nav class="crumbs" aria-label="{{ 'hpz.catalog.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'hpz.catalog.home' | t }}</a><span>{{ 'hpz.catalog.search_title' | t }}</span>
    </nav>
    <div class="col-h">
      <div>
        <h1 class="h1">
          {%- if search.performed and terms != blank -%}{{ 'hpz.catalog.search_results_for' | t: terms: terms }}{%- else -%}{{ 'hpz.catalog.search_title' | t }}{%- endif -%}
        </h1>
        {%- if search.performed and terms != blank -%}
          <p class="lead">{{ 'hpz.catalog.products_count' | t: count: search.results_count }}</p>
        {%- else -%}
          <p class="lead">{{ 'hpz.catalog.search_prompt' | t }}</p>
        {%- endif -%}
      </div>
      <form class="sx-form" action="{{ routes.search_url }}" method="get" role="search">
        <input class="input" type="search" name="q" value="{{ terms | escape }}" placeholder="{{ 'hpz.catalog.search_placeholder' | t }}" aria-label="{{ 'hpz.catalog.search_label' | t }}">
        <input type="hidden" name="type" value="{{ types_str | default: 'product' }}">
        <button class="btn btn-ink" type="submit">{{ 'hpz.catalog.search_button' | t }}</button>
      </form>
    </div>
    {%- if search.performed and terms != blank -%}
      <nav class="sx-tabs col-cats" aria-label="{{ 'hpz.catalog.search_title' | t }}">
        {%- assign tab_q = terms | url_encode -%}
        <a class="chip{% if active_tab == 'all' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ tab_q }}&type=product,article,page">{{ 'hpz.catalog.tab_all' | t }}</a>
        <a class="chip{% if active_tab == 'product' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ tab_q }}&type=product">{{ 'hpz.catalog.tab_products' | t }}</a>
        <a class="chip{% if active_tab == 'article' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ tab_q }}&type=article">{{ 'hpz.catalog.tab_articles' | t }}</a>
        <a class="chip{% if active_tab == 'page' %} is-on{% endif %}" href="{{ routes.search_url }}?q={{ tab_q }}&type=page">{{ 'hpz.catalog.tab_pages' | t }}</a>
      </nav>
    {%- endif -%}
  </div>
</section>

<section class="col-body" data-col-root data-section-id="{{ section.id }}" data-cols="{{ section.settings.columns }}">
  <div class="wrap col-in"{% unless has_filters %} style="grid-template-columns:minmax(0,1fr)"{% endunless %}>
    <aside class="filters" id="filters" aria-label="{{ 'hpz.catalog.filters' | t }}"{% unless has_filters %} hidden{% endunless %}>
      {%- if has_filters -%}
        {%- render 'collection-filters', filters: search.filters, count: search.results_count, action: routes.search_url, clear_url: clear_url, search_q: terms, search_type: types_str -%}
      {%- endif -%}
    </aside>
    <div class="results" data-part="results">
      {%- paginate search.results by per_page -%}
        {%- assign shown = paginate.current_offset | plus: search.results.size -%}
        {%- if search.performed and search.results_count > 0 -%}
          {%- if has_filters -%}
            {%- render 'collection-toolbar', count: search.results_count, filters: search.filters, sort_options: search.sort_options, sort_by: search.sort_by, clear_url: clear_url -%}
          {%- endif -%}
          {%- assign n_prod = 0 -%}
          {%- for item in search.results -%}{%- if item.object_type == 'product' -%}{%- assign n_prod = n_prod | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if n_prod > 0 -%}
            {%- render 'collection-quick' -%}
            <div class="grid" id="grid" style="--cols:{{ section.settings.columns }}">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {%- liquid
                    assign lazy = false
                    if forloop.index0 > 3
                      assign lazy = true
                    endif
                  -%}
                  {%- render 'product-card', product: item, index: forloop.index0, lazy: lazy -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="grid" id="grid" hidden></div>
          {%- endif -%}
          {%- if n_prod < search.results.size -%}
            <ul class="sx-list">
              {%- for item in search.results -%}
                {%- unless item.object_type == 'product' -%}
                  <li>
                    <a class="sx-item" href="{{ item.url }}">
                      {%- if item.image -%}<span class="sx-img">{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}</span>{%- endif -%}
                      <span class="sx-t">
                        <em class="mono">{%- if item.object_type == 'article' -%}{{ 'hpz.catalog.type_article' | t }}{%- else -%}{{ 'hpz.catalog.type_page' | t }}{%- endif -%}</em>
                        <b>{{ item.title | escape }}</b>
                        {%- assign excerpt = item.excerpt_or_content | default: item.content | strip_html | truncate: 160 -%}
                        {%- if excerpt != blank -%}<span>{{ excerpt }}</span>{%- endif -%}
                      </span>
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- render 'pagination', paginate: paginate, shown: shown -%}
        {%- elsif search.performed -%}
          {%- if has_filters and has_active -%}
            {%- render 'collection-toolbar', count: 0, filters: search.filters, sort_options: search.sort_options, sort_by: search.sort_by, clear_url: clear_url -%}
          {%- endif -%}
          <div class="grid" id="grid">
            <div class="empty">
              <div class="empty-w">{% render 'collection-wheel' %}</div>
              <h3 class="h3">{{ 'hpz.catalog.no_results_title' | t: terms: terms }}</h3>
              <p>{{ 'hpz.catalog.no_results_help' | t }}</p>
              <div>
                {%- if has_active -%}<a class="btn btn-ink" href="{{ clear_url }}" data-ajax>{{ 'hpz.catalog.clear_filters' | t }}</a>{%- endif -%}
                <a class="btn btn-ghost" href="{{ routes.root_url | append: 'pages/services' }}#request">{{ 'hpz.catalog.request_part' | t }}</a>
              </div>
            </div>
          </div>
          <div class="pager" id="pager"></div>
        {%- else -%}
          <div class="grid" id="grid" hidden></div>
          <div class="pager" id="pager"></div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

<noscript><style>.fl-f{display:grid !important}</style></noscript>
<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Default grid columns (desktop)", "default": "4", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ] }
  ]
}
{% endschema %}
