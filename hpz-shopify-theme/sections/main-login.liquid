{{ 'p-account.css' | asset_url | stylesheet_tag }}

<section class="lg is-in" id="login" data-account-auth>
  {% render 'account-auth-art' %}
  <div class="lg-form-w">
    <div class="lg-form" id="lg-form-wrap">
      <div class="lg-seg seg" role="tablist">
        <a class="is-on" href="{{ routes.account_login_url }}" role="tab" aria-selected="true">{{ 'hpz.account.sign_in' | t }}</a>
        <a href="{{ routes.account_register_url }}" role="tab" aria-selected="false">{{ 'hpz.account.create_account' | t }}</a>
      </div>

      {%- comment -%} Sign in {%- endcomment -%}
      <div id="login-panel">
        <div class="lg-head"><h2 class="h2">{{ 'hpz.account.welcome_back' | t }}</h2><p class="small muted">{{ 'hpz.account.welcome_sub' | t }}</p></div>
        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {%- if form.errors -%}<p class="err-msg" role="alert" style="display:block">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="lg-fields">
            <div class="fl"><input class="input" id="lg-e" name="customer[email]" type="email" placeholder=" " autocomplete="email" required value="{{ form.email }}"><label for="lg-e">{{ 'hpz.account.email' | t }}</label></div>
            <div class="fl lg-pw"><input class="input" id="lg-p" name="customer[password]" type="password" placeholder=" " autocomplete="current-password" required><label for="lg-p">{{ 'hpz.account.password' | t }}</label><button type="button" class="lg-eye" data-eye aria-label="{{ 'hpz.account.show_password' | t }}">{% render 'icon', name: 'eye' %}</button></div>
          </div>
          <div class="lg-row"><span></span><button type="button" class="link small" data-toggle-recover>{{ 'hpz.account.forgot' | t }}</button></div>
          <button class="btn btn-ink btn-lg btn-block" type="submit">{{ 'hpz.account.sign_in' | t }}</button>
        {%- endform -%}
        <p class="small muted" style="margin-top:16px">{{ 'hpz.account.no_account' | t }} <a class="link" href="{{ routes.account_register_url }}">{{ 'hpz.account.create_account' | t }}</a></p>
        {%- if shop.checkout.guest_login -%}
          {%- form 'guest_login' -%}<button class="link small" type="submit">{{ 'hpz.account.continue_guest' | t }}</button>{%- endform -%}
        {%- endif -%}
      </div>

      {%- comment -%} Password recovery {%- endcomment -%}
      <div id="recover-panel" hidden>
        <div class="lg-head"><h2 class="h2">{{ 'hpz.account.reset_title' | t }}</h2><p class="small muted">{{ 'hpz.account.reset_sub' | t }}</p></div>
        {%- form 'recover_customer_password' -%}
          {%- if form.posted_successfully? -%}<p class="small ok" role="status">{{ 'hpz.account.reset_sent' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="err-msg" role="alert" style="display:block">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="lg-fields"><div class="fl"><input class="input" id="rc-e" name="email" type="email" placeholder=" " autocomplete="email" required><label for="rc-e">{{ 'hpz.account.email' | t }}</label></div></div>
          <button class="btn btn-ink btn-lg btn-block" type="submit">{{ 'hpz.account.reset_send' | t }}</button>
          <button type="button" class="link small" data-toggle-recover>{{ 'hpz.account.back_sign_in' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'account.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sign in",
  "settings": []
}
{% endschema %}
