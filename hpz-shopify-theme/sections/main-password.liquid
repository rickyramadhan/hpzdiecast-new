{{ 'p-account.css' | asset_url | stylesheet_tag }}

<section class="lg is-in" id="login">
  {% render 'account-auth-art' %}
  <div class="lg-form-w">
    <div class="lg-form">
      <div class="lg-head"><h2 class="h2">{{ section.settings.heading | default: shop.name }}</h2>{%- if section.settings.text != blank -%}<p class="small muted">{{ section.settings.text }}</p>{%- endif -%}</div>
      {%- form 'customer', id: 'pw-signup' -%}
        {%- if form.posted_successfully? -%}<p class="small ok" role="status">{{ 'hpz.account.pw_thanks' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<p class="err-msg" role="alert" style="display:block">{{ form.errors | default_errors }}</p>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        <div class="lg-fields"><div class="fl"><input class="input" id="pw-e" name="contact[email]" type="email" placeholder=" " autocomplete="email" required><label for="pw-e">{{ 'hpz.account.email' | t }}</label></div></div>
        <button class="btn btn-ink btn-lg btn-block" type="submit">{{ 'hpz.account.pw_notify' | t }}</button>
      {%- endform -%}
      <details style="margin-top:24px"><summary class="link small">{{ 'hpz.account.pw_enter' | t }}</summary>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<p class="err-msg" role="alert" style="display:block">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="lg-fields"><div class="fl"><input class="input" id="pw-p" name="password" type="password" placeholder=" " required><label for="pw-p">{{ 'hpz.account.password' | t }}</label></div></div>
          <button class="btn btn-ghost btn-block" type="submit">{{ 'hpz.account.pw_submit' | t }}</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ]
}
{% endschema %}
