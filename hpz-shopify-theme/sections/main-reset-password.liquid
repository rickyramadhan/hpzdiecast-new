{{ 'p-account.css' | asset_url | stylesheet_tag }}

<section class="lg is-in" id="login" data-account-auth>
  {% render 'account-auth-art' %}
  <div class="lg-form-w">
    <div class="lg-form">
      <div class="lg-head"><h2 class="h2">{{ 'hpz.account.new_password_title' | t }}</h2><p class="small muted">{{ 'hpz.account.new_password_sub' | t: email: email }}</p></div>
      {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<p class="err-msg" role="alert" style="display:block">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="lg-fields">
          <div class="fl lg-pw"><input class="input" id="lg-p" name="customer[password]" type="password" placeholder=" " autocomplete="new-password" required><label for="lg-p">{{ 'hpz.account.password' | t }}</label><button type="button" class="lg-eye" data-eye aria-label="{{ 'hpz.account.show_password' | t }}">{% render 'icon', name: 'eye' %}</button></div>
          <div class="fl"><input class="input" id="lg-p2" name="customer[password_confirmation]" type="password" placeholder=" " autocomplete="new-password" required><label for="lg-p2">{{ 'hpz.account.password_confirm' | t }}</label></div>
        </div>
        <button class="btn btn-ink btn-lg btn-block" type="submit">{{ 'hpz.account.reset_password' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

<script src="{{ 'account.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
