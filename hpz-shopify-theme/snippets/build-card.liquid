{%- comment -%}
  One gallery tile for a `build` metaobject + its embedded JSON blob (read by assets/builds.js to draw the modal).
  Params: build (metaobject), index (number), lazy (bool)
{%- endcomment -%}
{%- liquid
  assign b = build
  assign handle = b.system.handle
  assign title = b.title.value | default: handle
  assign builder = b.builder.value
  assign photo = b.photo.value
  assign cast = b.casting.value
  assign likes = b.likes.value | default: 0
  assign hotspots = b.hotspots.value
  assign seen = '|'
  assign parts_n = 0
  assign cast_handle = ''
  assign cast_name = ''
  if cast
    assign cast_handle = cast.system.handle
    assign cast_name = cast.name.value
  endif

  capture parts_json
    for h in hotspots
      assign hp = all_products[h.product]
      if hp.id
        assign key = hp.id | prepend: '|' | append: '|'
        unless seen contains key
          assign seen = seen | append: hp.id | append: '|'
          if parts_n > 0
            echo ','
          endif
          render 'build-part', product: hp, variant_title: h.variant, x: h.x, y: h.y
          assign parts_n = parts_n | plus: 1
        endunless
      endif
    endfor
    for lp in b.products.value
      assign key = lp.id | prepend: '|' | append: '|'
      unless seen contains key
        assign seen = seen | append: lp.id | append: '|'
        if parts_n > 0
          echo ','
        endif
        render 'build-part', product: lp
        assign parts_n = parts_n | plus: 1
      endunless
    endfor
  endcapture
-%}
<figure class="bt" data-reveal style="--i:{{ index | modulo: 6 }}" data-build-card="{{ handle }}" data-casting="{{ cast_handle }}" data-casting-name="{{ cast_name | escape }}" data-likes="{{ likes }}" data-parts="{{ parts_n }}" data-order="{{ index }}">
  <button class="bt-img" type="button" data-build="{{ handle }}" aria-label="{{ title | escape }}">
    {%- if photo -%}
      {{ photo | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 1000px) 25vw, 50vw', alt: photo.alt | default: title, loading: 'lazy' }}
    {%- endif -%}
    {%- for h in hotspots -%}
      {%- if h.x != blank and h.y != blank -%}<span class="bt-dot" style="left:{{ h.x }}%;top:{{ h.y }}%"></span>{%- endif -%}
    {%- endfor -%}
    <span class="bt-shop">{% render 'icon', name: 'cart' %}{{ 'hpz.builds.shop_build' | t }}{% if parts_n > 0 %} &middot; {{ parts_n }} {{ 'hpz.builds.parts' | t }}{% endif %}</span>
  </button>
  <figcaption>
    <div><b>{{ title }}</b><span class="mono">{% if builder != blank %}@{{ builder }}{% endif %}{% if cast_name != blank %}{% if builder != blank %} &middot; {% endif %}{{ cast_name }}{% endif %}</span></div>
    <button class="bt-like" type="button" data-like="{{ handle }}" aria-label="{{ 'hpz.builds.like' | t }}">{% render 'icon', name: 'heart' %}<span class="mono">{{ likes }}</span></button>
  </figcaption>
  <script type="application/json" data-build-json>{"id":{{ handle | json }},"title":{{ title | json }},"builder":{{ builder | json }},"photo":{{ photo | image_url: width: 1200 | json }},"photoAlt":{{ photo.alt | default: title | json }},"story":{{ b.story.value | json }},"casting":{"handle":{{ cast_handle | json }},"name":{{ cast_name | json }},"body":{{ cast.body.value | json }}},"likes":{{ likes }},"parts":[{{ parts_json }}]}</script>
</figure>
