{%- comment -%} Left art panel of the sign-in / register pages {%- endcomment -%}
<div class="lg-art mat">
  <div class="lg-ruler" aria-hidden="true"></div>
  <div class="lg-art-in">
    <span class="eyebrow"><b>HPZ-ACC</b> <span>{{ 'hpz.account.auth_eyebrow' | t }}</span></span>
    <h1 class="display lg-h">{{ 'hpz.account.auth_title' | t }}</h1>
    <div class="lg-wheel" aria-hidden="true" data-lg-wheel></div>
    <ul class="lg-perks">
      <li><span class="mono">01</span><div><b>{{ 'hpz.account.perk1_t' | t }}</b><span>{{ 'hpz.account.perk1_d' | t }}</span></div></li>
      <li><span class="mono">02</span><div><b>{{ 'hpz.account.perk2_t' | t }}</b><span>{{ 'hpz.account.perk2_d' | t }}</span></div></li>
      <li><span class="mono">03</span><div><b>{{ 'hpz.account.perk3_t' | t }}</b><span>{{ 'hpz.account.perk3_d' | t }}</span></div></li>
    </ul>
  </div>
</div>
