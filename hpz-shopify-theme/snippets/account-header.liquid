{%- comment -%} Account page title band. Params: crumb (string), show_id (bool) {%- endcomment -%}
<section class="ac-top">
  <div class="wrap ac-top-in">
    <div>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'hpz.account.home' | t }}</a><a href="{{ routes.account_url }}">{{ 'hpz.account.account' | t }}</a>{% if crumb != blank %}<span>{{ crumb }}</span>{% endif %}</nav>
      <h1 class="h1 ac-h1">{{ 'hpz.account.garage_title' | t }}</h1>
    </div>
    {%- if customer -%}
      <div class="ac-id"><span class="ac-av" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</span><div><b>{{ customer.name | default: customer.email }}</b><span class="mono">{{ customer.email }}</span></div></div>
    {%- endif -%}
  </div>
</section>
